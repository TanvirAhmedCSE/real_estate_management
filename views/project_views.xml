<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_list" model="ir.ui.view">
        <field name="name">real.estate.project.list</field>
        <field name="model">real.estate.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="location"/>
                <field name="unit_count"/>
                <field name="available_count"/>
                <field name="sold_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_project_form" model="ir.ui.view">
        <field name="name">real.estate.project.form</field>
        <field name="model">real.estate.project</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': True}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_units" type="object" class="oe_stat_button" icon="fa-home">
                            <field name="unit_count" widget="statinfo" string="Units"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Project name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="available_count"/>
                            <field name="sold_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Buildings / Blocks" name="buildings">
                            <field name="building_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="floors"/>
                                    <field name="unit_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_project_search" model="ir.ui.view">
        <field name="name">real.estate.project.search</field>
        <field name="model">real.estate.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="location"/>
                <filter name="ongoing" string="Ongoing" domain="[('state', '=', 'ongoing')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">real.estate.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_building_list" model="ir.ui.view">
        <field name="name">real.estate.building.list</field>
        <field name="model">real.estate.building</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="project_id"/>
                <field name="name"/>
                <field name="floors"/>
                <field name="unit_count"/>
            </list>
        </field>
    </record>

    <record id="action_building" model="ir.actions.act_window">
        <field name="name">Buildings / Blocks</field>
        <field name="res_model">real.estate.building</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
