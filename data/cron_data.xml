<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_installment_reminders" model="ir.cron">
        <field name="name">Real Estate: Installment reminders &amp; overdue</field>
        <field name="model_id" ref="model_real_estate_installment_line"/>
        <field name="state">code</field>
        <field name="code">model._cron_installment_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_send_receipts" model="ir.cron">
        <field name="name">Real Estate: Send payment receipts</field>
        <field name="model_id" ref="model_real_estate_installment_line"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_receipts()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
