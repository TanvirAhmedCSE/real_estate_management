<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shared report styling (same look as quality_control report) -->
    <template id="re_report_style">
        <style>
            .re-title { color: #1f4e79; border-bottom: 3px solid #1f4e79; padding-bottom: 6px; }
            .re-bold,
            .re-table thead th,
            .re-table tfoot td,
            .re-table tfoot td span,
            .re-kv td:first-child {
                font-family: Arial, Helvetica, sans-serif !important;
                font-weight: 700 !important;
            }
            .re-table { border: 2px solid #1f4e79; }
            .re-table th, .re-table td {
                text-align: center !important; vertical-align: middle;
                border-color: #1f4e79 !important; padding: 6px 8px !important;
            }
            .re-table th.re-left, .re-table td.re-left { text-align: left !important; }
            .re-table th.re-right, .re-table td.re-right { text-align: right !important; }
            .re-table th { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .re-table thead th { background-color: #1f4e79; color: #ffffff; }
            .re-table tfoot td { background-color: #d6e6f5; }
            .re-table tbody tr.re-alt > td { background-color: #eaf2fa !important; }

            .re-green { border: 2px solid #2e7d32 !important; }
            .re-green th, .re-green td { border-color: #2e7d32 !important; }
            .re-green thead th { background-color: #2e7d32; color: #ffffff; }
            .re-green tfoot td { background-color: #d8eed9; }
            .re-green tbody tr.re-alt > td { background-color: #eaf6eb !important; }

            .re-orange { border: 2px solid #ef6c00 !important; }
            .re-orange th, .re-orange td { border-color: #ef6c00 !important; }
            .re-orange thead th { background-color: #ef6c00; color: #ffffff; }
            .re-orange tfoot td { background-color: #fbe0c3; }
            .re-orange tbody tr.re-alt > td { background-color: #fdf0e2 !important; }

            .re-text-green { color: #2e7d32 !important; }
            .re-text-red { color: #c62828 !important; }
            .re-text-orange { color: #ef6c00 !important; }
        </style>
    </template>

    <!-- Booking slip -->
    <template id="report_booking_slip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-call="real_estate_management.re_report_style"/>
                        <h2 class="re-title">Booking Slip <small t-out="o.name"/></h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <p><strong>Customer:</strong> <span t-field="o.partner_id"/></p>
                                <p><strong>Phone:</strong> <span t-out="o.partner_id.phone or '-'"/></p>
                                <p><strong>Booking date:</strong> <span t-field="o.booking_date"/></p>
                                <p t-if="o.agent_id"><strong>Sales agent:</strong> <span t-field="o.agent_id"/></p>
                            </div>
                            <div class="col-6">
                                <p><strong>Project:</strong> <span t-field="o.project_id"/></p>
                                <p><strong>Unit:</strong> <span t-out="o.unit_id.display_name"/></p>
                                <p><strong>Type / Size:</strong> <span t-field="o.unit_id.unit_type"/> / <span t-field="o.unit_id.size"/> <span t-field="o.unit_id.size_unit"/></p>
                                <p><strong>Floor:</strong> <span t-out="o.unit_id.floor or '-'"/></p>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered re-table re-kv mt-3">
                            <thead>
                                <tr><th class="re-left">Particulars</th><th class="re-right">Amount</th></tr>
                            </thead>
                            <tbody>
                                <tr><td class="re-left">Unit price</td><td class="re-right"><span t-field="o.unit_price" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr class="re-alt"><td class="re-left">Discount</td><td class="re-right"><span t-field="o.discount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr><td class="re-left">Booking money</td><td class="re-right"><span t-field="o.booking_money" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr class="re-alt"><td class="re-left">Down payment</td><td class="re-right"><span t-field="o.down_payment" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr><td class="re-left">Handover payment</td><td class="re-right"><span t-field="o.handover_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr class="re-alt"><td class="re-left">Installments</td><td class="re-right"><span t-out="o.installment_count"/> x <span t-field="o.installment_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/> (every <span t-out="o.interval_months"/> month)</td></tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td class="re-left">Total price</td>
                                    <td class="re-right"><span t-field="o.total_price" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="row mt-5 pt-5">
                            <div class="col-6 text-center">______________________<br/>Customer Signature</div>
                            <div class="col-6 text-center">______________________<br/>Authorized Signature</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Statement per unit -->
    <template id="report_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-call="real_estate_management.re_report_style"/>
                        <h2 class="re-title">Statement <small t-out="o.name"/></h2>
                        <p class="mt-3">
                            <strong>Customer:</strong> <span t-field="o.partner_id"/> |
                            <strong>Unit:</strong> <span t-out="o.unit_id.display_name"/> |
                            <strong>Total price:</strong> <span t-field="o.total_price" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                        </p>
                        <t t-set="stmt_lines" t-value="o.line_ids.filtered(lambda l: l.state != 'cancel')"/>
                        <table class="table table-sm table-bordered re-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th class="re-left">Description</th>
                                    <th>Due Date</th>
                                    <th class="re-right">Amount</th>
                                    <th class="re-right">Late Fee</th>
                                    <th>Status</th>
                                    <th>Paid On</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="stmt_lines" t-as="l">
                                    <tr t-att-class="'re-alt' if l_index % 2 else ''">
                                        <td><t t-out="l_index + 1"/></td>
                                        <td class="re-left"><t t-out="l.name"/></td>
                                        <td><span t-field="l.due_date"/></td>
                                        <td class="re-right"><span t-field="l.amount" t-options="{'widget': 'monetary', 'display_currency': l.currency_id}"/></td>
                                        <td class="re-right"><span t-field="l.late_fee" t-options="{'widget': 'monetary', 'display_currency': l.currency_id}"/></td>
                                        <td><span t-field="l.state" t-att-class="'re-bold re-text-green' if l.state == 'paid' else 're-bold re-text-red' if l.state == 'overdue' else 're-bold re-text-orange'"/></td>
                                        <td><span t-field="l.paid_date"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot t-if="stmt_lines">
                                <tr>
                                    <td colspan="3" class="re-left">Total</td>
                                    <td class="re-right"><span t-out="sum(stmt_lines.mapped('amount'))" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    <td class="re-right"><span t-out="sum(stmt_lines.mapped('late_fee'))" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    <td colspan="2"/>
                                </tr>
                            </tfoot>
                        </table>
                        <table class="table table-sm table-bordered re-table re-green re-kv w-50 ms-auto mt-4">
                            <tbody>
                                <tr><td class="re-left">Total paid</td><td class="re-right re-text-green"><span class="re-bold" t-field="o.paid_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr class="re-alt"><td class="re-left">Balance</td><td class="re-right"><span class="re-bold" t-field="o.balance_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr><td class="re-left">Overdue (incl. late fee)</td><td class="re-right re-text-red"><span class="re-bold" t-field="o.overdue_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Payment receipt -->
    <template id="report_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-call="real_estate_management.re_report_style"/>
                        <h2 class="re-title">Payment Receipt</h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <p><strong>Received from:</strong> <span t-field="o.partner_id"/></p>
                                <p><strong>Booking:</strong> <span t-out="o.booking_id.name"/></p>
                                <p><strong>Unit:</strong> <span t-out="o.unit_id.display_name"/></p>
                            </div>
                            <div class="col-6">
                                <p><strong>Date:</strong> <span t-field="o.paid_date"/></p>
                                <p><strong>Reference:</strong> <span t-out="o.invoice_id.name or '-'"/></p>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered re-table re-green mt-3">
                            <thead><tr><th class="re-left">Description</th><th class="re-right">Amount</th></tr></thead>
                            <tbody>
                                <tr><td class="re-left" t-out="o.name"/><td class="re-right"><span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr t-if="o.late_fee" class="re-alt"><td class="re-left">Late fee</td><td class="re-right"><span t-field="o.late_fee" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td class="re-left">Total received</td>
                                    <td class="re-right"><span t-field="o.total_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                            </tfoot>
                        </table>
                        <p class="mt-4"><strong>Remaining balance on this booking:</strong>
                            <span t-field="o.booking_id.balance_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Dashboard export -->
    <template id="report_dashboard">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-call="real_estate_management.re_report_style"/>
                    <h2 class="re-title">Real Estate Dashboard</h2>
                    <p class="text-muted mt-2">Period: <t t-out="period"/></p>

                    <h5 class="mt-4">Summary</h5>
                    <table class="table table-sm table-bordered re-table re-kv">
                        <tbody>
                            <tr t-foreach="summary" t-as="row" t-key="row_index"
                                t-att-class="'re-alt' if row_index % 2 else ''">
                                <td class="re-left"><t t-out="row[0]"/></td>
                                <td class="re-right"><span class="re-bold"><t t-out="row[1]"/></span></td>
                            </tr>
                        </tbody>
                    </table>

                    <h5 class="mt-4">Bookings &amp; Collection Trend</h5>
                    <table class="table table-sm table-bordered re-table re-green">
                        <thead><tr><th class="re-left">Month</th><th class="re-right">Bookings</th><th class="re-right">Collection</th></tr></thead>
                        <tbody>
                            <tr t-foreach="trend" t-as="r" t-key="r_index"
                                t-att-class="'re-alt' if r_index % 2 else ''">
                                <td class="re-left"><t t-out="r['label']"/></td>
                                <td class="re-right"><t t-out="r['bookings']"/></td>
                                <td class="re-right"><t t-out="r['collection_txt']"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <h5 class="mt-4">Sales by Project</h5>
                    <table class="table table-sm table-bordered re-table re-orange">
                        <thead><tr><th class="re-left">Project</th><th class="re-right">Bookings</th></tr></thead>
                        <tbody>
                            <tr t-foreach="d['by_project']" t-as="p" t-key="p_index"
                                t-att-class="'re-alt' if p_index % 2 else ''">
                                <td class="re-left"><t t-out="p['label']"/></td>
                                <td class="re-right"><t t-out="p['count']"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <h5 class="mt-4">Recent Bookings</h5>
                    <table class="table table-sm table-bordered re-table">
                        <thead>
                            <tr><th>Booking</th><th>Customer</th><th>Unit</th><th>Project</th>
                                <th class="re-right">Amount</th><th>Status</th><th>Date</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="bookings" t-as="b" t-key="b_index"
                                t-att-class="'re-alt' if b_index % 2 else ''">
                                <td><t t-out="b['name']"/></td>
                                <td><t t-out="b['customer']"/></td>
                                <td><t t-out="b['unit']"/></td>
                                <td><t t-out="b['project']"/></td>
                                <td class="re-right"><t t-out="b['amount_txt']"/></td>
                                <td><t t-out="b['state_label']"/></td>
                                <td><t t-out="b['date']"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <h5 class="mt-4">Upcoming &amp; Overdue Installments</h5>
                    <table class="table table-sm table-bordered re-table re-green">
                        <thead><tr><th>Due Date</th><th class="re-left">Customer</th><th class="re-right">Amount</th><th>Status</th></tr></thead>
                        <tbody>
                            <tr t-foreach="installments" t-as="l" t-key="l_index"
                                t-att-class="'re-alt' if l_index % 2 else ''">
                                <td><t t-out="l['due_date']"/></td>
                                <td class="re-left"><t t-out="l['customer']"/></td>
                                <td class="re-right"><t t-out="l['amount_txt']"/></td>
                                <td><t t-out="l['label']"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>