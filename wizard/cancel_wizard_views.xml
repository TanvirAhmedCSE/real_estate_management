<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cancel_wizard_form" model="ir.ui.view">
        <field name="name">real.estate.cancel.wizard.form</field>
        <field name="model">real.estate.cancel.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="booking_id"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="paid_amount"/>
                        <field name="deduction_percent"/>
                    </group>
                    <group>
                        <field name="deduction_amount"/>
                        <field name="refund_amount"/>
                    </group>
                </group>
                <field name="reason" placeholder="Reason for cancellation..."/>
                <footer>
                    <button name="action_cancel_booking" string="Cancel Booking" type="object"
                            class="btn-danger" confirm="Cancel this booking and release the unit?"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
